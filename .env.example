# Fake placeholders only. Copy to .env and replace privately for connected startup.
TELEGRAM_API_ID=12345
TELEGRAM_API_HASH=fake_telegram_hash
TELEGRAM_PHONE=+10000000000
TELEGRAM_SESSION=trading_bot
TELEGRAM_CHANNEL_ID=-1000000000000
BINANCE_API_KEY=fake_binance_key
BINANCE_API_SECRET=fake_binance_secret

# Safest defaults: dry-run blocks ALL exchange mutations; testnet selects Binance Futures testnet endpoints.
BINANCE_TESTNET=true
DRY_RUN=true
# TRADE_AMOUNT is margin USDT; requested notional = margin * leverage.
TRADE_AMOUNT=100
DEFAULT_LEVERAGE=5
ORDER_LIFETIME_SEC=120
# Decimal fraction: 0.01 means 1% above/below filled average, not signal TP/SL.
TPSL_PCT=0.01
WORKING_TYPE=MARK_PRICE
PARTIAL_POLICY=ATTACH_AND_CANCEL
# User-data stream is started only when dry-run is disabled.
WEBSOCKET_ENABLED=true
ALERT_ENABLED=false
ALERT_TARGET=me
VERBOSE_ALERTS=false
# Opt-in private raw-message diagnostics. Never publish these files.
DUMP_IGNORED=false
DUMP_IGNORED_TO_ME=false
LOG_LEVEL=INFO
LOG_FILE=bot.log
PROBE_SYMBOLS=
